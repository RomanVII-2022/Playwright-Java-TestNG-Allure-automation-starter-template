# ============================================
# Playwright Java Test Framework Template
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# Web Platform Credentials
WEB_EMAIL=your-email@example.com
WEB_PASSWORD=your-password

# API Platform Credentials
API_EMAIL=your-api-email@example.com
API_PASSWORD=your-api-password

# ============================================
# Browser Configuration
# ============================================
# Options: chromium (default), firefox, webkit
BROWSER=chromium

# Run tests in headless mode
# Options: true, false (default)
HEADLESS=false

# Slow motion in milliseconds (for debugging)
SLOW_MO=0

# Platform to test
# Options: web, api
PLATFORM=web
